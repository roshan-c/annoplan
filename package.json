{
  "name": "annoplan",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "tauri": "node scripts/tauri.mjs",
    "fixtures": "node scripts/fixtures.mjs",
    "postinstall": "node scripts/pdf-assets.mjs",
    "format": "prettier --write src scripts *.json *.ts *.html",
    "mcp:build": "pnpm --dir mcp build",
    "mcp:test": "pnpm --dir mcp test",
    "share:build": "vite build --config vite.share.config.ts",
    "share:test": "pnpm --dir share test",
    "share:e2e": "cargo build --manifest-path src-tauri/Cargo.toml --example share-db-harness && tsx scripts/local-share-e2e.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "docx-preview": "^0.3",
    "lucide-react": "^0.468",
    "markdown-it": "^14",
    "pdfjs-dist": "^5",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2",
    "@tauri-apps/cli": "^2",
    "@types/markdown-it": "^14",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5",
    "docx": "^9",
    "pdf-lib": "^1",
    "playwright": "^1.64.1",
    "prettier": "^3",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vite": "^7",
    "vitest": "^3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
